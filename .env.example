# ==============================================================================
# IT Asset & Inventory Management System - Environment Configuration Example
# ==============================================================================
# Copy this file to '.env' and provide your actual local or deployment credentials.
# NEVER commit real credentials or actual '.env' files to version control!

# ------------------------------------------------------------------------------
# Server Application Settings
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# ------------------------------------------------------------------------------
# PostgreSQL Database Connection Configuration
# ------------------------------------------------------------------------------
# Standard PostgreSQL parameters (used by connection pool)
PGHOST=localhost
PGPORT=5432
PGDATABASE=it_asset_management
PGUSER=postgres
PGPASSWORD=your_postgres_password_here

# Optional: Full Database Connection URL (takes precedence if provided)
# DATABASE_URL=postgresql://postgres:your_postgres_password_here@localhost:5432/it_asset_management

# ------------------------------------------------------------------------------
# PostgreSQL Connection Pool Tuning
# ------------------------------------------------------------------------------
PGMAX_CLIENTS=10
PGIDLE_TIMEOUT_MS=30000
PGCONN_TIMEOUT_MS=5000
PGSSL=false
